---
import { Image } from 'astro:assets';
import { site } from '../content/site';
import { resolvedCollage } from '../content/collage';
import PhotoCreditLine from './PhotoCreditLine.astro';

/**
 * The opening frame.
 *
 * It is an editorial plate, not a full-bleed photograph: a band of historical
 * cartography, the world, the country, the state, the terrain, holding one
 * living cell that is a real, named place in Caripe. Every map is in greyscale,
 * so the grid and the paper are the texture; the single photograph is the note
 * that moves.
 *
 * The title does not fade in. It **condenses out of the fog**: each letter is a
 * span whose droplet drifts in, flashes faintly and lets its glyph condense.
 * The choreography is CSS driven by one custom property per letter (`--t`),
 * written only by `src/scripts/letters.ts`; with no JavaScript, or with motion
 * switched off, every letter is simply present and still.
 *
 * The geography lives in the standfirst and the facts, so the first thing a
 * reader meets is still the name of the place.
 */
const { facts } = site;

/** Support text arrives after the collage and the title, ~70ms apart. */
const textDelay = [950, 1020, 1090, 1160];

/** The title, split into letters that will travel as droplets. */
const letters = site.title.split('');
const lastIndex = Math.max(1, letters.length - 1);

/**
 * A droplet's starting offset, seeded so it is calculated once and is stable
 * between builds (never random per load). `sx` spreads left/right, `sy` falls
 * in from above the glyph.
 */
const seeded = (index: number, salt: number): number => {
  const value = Math.sin((index + 1) * 127.1 + salt * 311.7) * 43758.5453;
  return value - Math.floor(value);
};

const titleLetters = letters.map((char, index) => ({
  char,
  /** stagger position, 0 → 1, read by CSS and JS as `data-d` */
  d: (index / lastIndex).toFixed(4),
  sx: ((seeded(index, 1) * 2 - 1) * 1.05).toFixed(3),
  sy: (-0.35 - seeded(index, 2) * 0.95).toFixed(3),
}));

/** Responsive `sizes` per cell weight; the living cell is the widest. */
const sizesFor = (slot: string): string =>
  slot === 'living'
    ? '(max-width: 48rem) 100vw, (max-width: 60rem) 50vw, 34vw'
    : '(max-width: 48rem) 50vw, (max-width: 60rem) 25vw, 17vw';

/** Stored masters are capped at 1280px; these ladders stay inside that. */
const widthsFor = (slot: string): number[] =>
  slot === 'living' ? [360, 480, 720, 960, 1280] : [240, 360, 480, 720];
---

<section class="hero" id="prologue" aria-labelledby="hero-title" data-scene="hero" data-time={site.title}>
  <div class="hero__collage" data-collage>
    {
      resolvedCollage.map(({ cell, image }) => (
        <figure class:list={['cell', `cell--${cell.slot}`]} data-cell={cell.slot}>
          <Image
            class="cell__img"
            src={image.src}
            alt={cell.alt}
            widths={widthsFor(cell.slot)}
            sizes={sizesFor(cell.slot)}
            format="webp"
            quality={74}
            loading={cell.slot === 'living' ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={cell.slot === 'living' ? 'high' : undefined}
          />
          <div class="u-scrim" aria-hidden="true" />

          <figcaption class="cell__caption">
            <span class="cell__text">{cell.caption}</span>
            <PhotoCreditLine credit={image.credit} />
          </figcaption>

          {cell.slot === 'living' && (
            /* Reserved, empty slot for a real clip. A ~10-second, hand-held
               video of mist drifting over the cordillera de Caripe, shot on a
               phone, grey morning light, no narration, replaces this div: swap
               it for a muted, looping <video> with a poster frame. There is no
               free, honestly-Caripe clip today, so the cell holds a slow drift
               on the still photograph instead. */
            <div class="cell__video" data-video-slot />
          )}
        </figure>
      ))
    }
  </div>

  <div class="hero__content u-container">
    <h1
      class="hero__title"
      id="hero-title"
      data-letters
      data-start="0.05"
      data-spread="0.62"
      data-dur="0.32"
    >
      <span class="hero__title-visual" aria-hidden="true">
        {
          titleLetters.map((letter) => (
            <span class="l" data-d={letter.d} style={`--sx:${letter.sx};--sy:${letter.sy}`}>
              <span class="l__glyph">{letter.char}</span>
            </span>
          ))
        }
      </span>
      <span class="sr-only">{site.title}</span>
    </h1>

    <p class="hero__full-title" style={`animation-delay:${textDelay[0]}ms`}>{site.fullTitle}</p>

    <p class="hero__epithet" style={`animation-delay:${textDelay[1]}ms`}>
      <span class="hero__epithet-word">«{site.epithet}»</span>
      <span class="hero__epithet-note">{site.epithetNote}</span>
    </p>

    <p class="hero__standfirst" style={`animation-delay:${textDelay[2]}ms`}>{site.standfirst}</p>

    <dl class="hero__facts" style={`animation-delay:${textDelay[3]}ms`}>
      {
        facts.map((fact) => (
          <>
            <dt class="hero__fact-label">{fact.label}</dt>
            <dd class="hero__fact-value">{fact.value}</dd>
          </>
        ))
      }
    </dl>

    <p class="hero__cue">
      <span class="hero__cue-label">{site.scrollCue}</span>
      <span class="hero__cue-arrow" aria-hidden="true"></span>
    </p>
  </div>
</section>

<style>
  /* Registered as a number so the per-letter progress is a cheap, typed value
     the browser can interpolate, not a re-parsed token. */
  @property --t {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }

  .hero {
    position: relative;
    isolation: isolate;
  }

  /* -- The collage: paper, grid, one living cell --------------------------- */

  .hero__collage {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    height: 52svh;
    min-height: 300px;
    background-color: var(--cu-monte-950);
    animation: cu-collage-in 900ms var(--cu-ease) both;
  }

  /* The narrative scale, laid on the grid: the place, then outwards to the
     world and back down to the terrain. */
  .cell--living {
    grid-area: 1 / 1 / 3 / 3;
  }
  .cell--guiana-blaeu {
    grid-area: 1 / 3 / 2 / 4;
  }
  .cell--guiana-sanson {
    grid-area: 1 / 4 / 2 / 5;
  }
  .cell--orinoco {
    grid-area: 1 / 5 / 3 / 6;
  }
  .cell--venezuela-pinkerton {
    grid-area: 2 / 3 / 3 / 5;
  }
  .cell--monagas {
    grid-area: 1 / 6 / 2 / 7;
  }
  .cell--buja {
    grid-area: 2 / 6 / 3 / 7;
  }

  .cell {
    position: relative;
    margin: 0;
    overflow: clip;
    background-color: var(--cu-monte-900);
  }

  .cell__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The owner's treatment: every map in greyscale, which is what makes the
       paper read and the grid carry the frame. */
    filter: grayscale(1) contrast(1.05);
  }

  /* The one cell that lives: a slow, continuous drift, in a loop. It is a real
     photograph of a real place, so it moves; it never becomes a different one. */
  .cell--living .cell__img {
    animation: cu-drift 30s var(--cu-ease) infinite alternate;
    will-change: transform;
  }

  .cell__caption {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: grid;
    gap: 0.2rem;
    padding: var(--cu-space-xs) var(--cu-space-xs) var(--cu-space-2xs);
    color: var(--cu-hueso);
  }

  .cell__text {
    max-width: 34ch;
    font-size: var(--cu-step--2);
    line-height: 1.4;
    text-wrap: pretty;
  }

  /* The credit sits over a picture; lift it off the faint ink used on the page
     ground. */
  .cell__caption :global(.credit),
  .cell__caption :global(.credit__author),
  .cell__caption :global(.credit__license),
  .cell__caption :global(.credit__link) {
    color: var(--cu-bruma-200);
  }

  /* A reserved, empty slot: nothing is drawn here until a real clip exists. */
  .cell__video {
    display: none;
  }

  /* -- The title: letters condensing out of fog ---------------------------- */

  .hero__title {
    font-family: var(--cu-font-display);
    font-weight: 500;
    font-variation-settings: 'opsz' 144, 'wght' 480, 'SOFT' 30, 'WONK' 1;
    font-size: var(--cu-step-6);
    line-height: 0.92;
    letter-spacing: -0.025em;
    color: var(--cu-hueso);
  }

  .hero__title-visual {
    display: inline-flex;
  }

  .l {
    position: relative;
    display: inline-block;
  }

  .l__glyph {
    display: inline-block;
  }

  /* The real title, for assistive technology: the letters above are decorative
     and hidden from it. Without this rule the accessible name would be read out
     as a second, visible copy of the title. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Armed / ready: the states the title lives in only while the script is in
     charge. The default (no JS, reduced motion, or a failed script) is a plain,
     readable title, never a hidden one. */
  :global(html:is([data-letters='armed'], [data-letters='ready'])) .l {
    --m0: clamp(0, calc(var(--t) / 0.72), 1);
    --m: calc(var(--m0) * var(--m0) * (3 - 2 * var(--m0)));
    --f: clamp(0, calc((var(--t) - 0.6) / 0.2), 1);
    --g0: clamp(0, calc((var(--t) - 0.66) / 0.34), 1);
    --g: calc(var(--g0) * var(--g0) * (3 - 2 * var(--g0)));
    --pa: calc(clamp(0, calc(var(--m0) * 1.4), 1) * (1 - var(--g)) * (0.5 + 0.5 * var(--f)));
  }

  /* Only the letters actually travelling are promoted, so the compositor is
     asked for work only where there is work to do. */
  .l.is-moving .l__glyph {
    will-change: opacity, transform;
  }

  /* The light condenses into the letter. */
  :global(html:is([data-letters='armed'], [data-letters='ready'])) .l__glyph {
    opacity: var(--g);
    transform: scale(calc(1.14 - 0.14 * var(--g)));
  }

  /* The droplet: a fog bead that drifts in on a smooth curve and flashes as it
     arrives. It is a single small element, so it stays cheap. */
  :global(html:is([data-letters='armed'], [data-letters='ready'])) .l::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.32em;
    height: 0.32em;
    margin: -0.16em 0 0 -0.16em;
    border-radius: 50%;
    background-color: var(--cu-bruma-100);
    filter: blur(0.5px);
    opacity: var(--pa);
    transform: translate(
        calc(var(--sx) * 1em * (1 - var(--m))),
        calc(var(--sy) * 1em * (1 - var(--m)))
      )
      scale(calc(0.7 + 0.7 * var(--f)));
    pointer-events: none;
  }

  /* -- Content: the name of the place and its orientation ------------------ */

  .hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: start;
    /* A real breath between the plate and the name: the collage is its own
       object, and the title must not read as its label. */
    padding-block: clamp(5rem, 3rem + 9vw, 12rem) var(--cu-space-2xl);
  }

  .hero__full-title {
    margin-top: var(--cu-space-2xs);
    font-family: var(--cu-font-display);
    font-size: var(--cu-step-1);
    font-style: italic;
    font-variation-settings: 'opsz' 60, 'SOFT' 60, 'WONK' 0;
    letter-spacing: 0.02em;
    color: var(--cu-bruma-100);
    animation: cu-rise 900ms var(--cu-ease) both;
  }

  .hero__epithet {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--cu-space-2xs) var(--cu-space-sm);
    margin-top: var(--cu-space-md);
    max-width: 44rem;
    animation: cu-rise 900ms var(--cu-ease) both;
  }

  .hero__epithet-word {
    font-family: var(--cu-font-display);
    font-size: var(--cu-step-2);
    font-style: italic;
    color: var(--cu-accent-soft);
  }

  .hero__epithet-note {
    font-size: var(--cu-step--1);
    color: var(--cu-bruma-200);
  }

  .hero__standfirst {
    margin-top: var(--cu-space-sm);
    max-width: 40rem;
    font-size: var(--cu-step-1);
    line-height: 1.6;
    color: var(--cu-hueso-soft);
    animation: cu-rise 900ms var(--cu-ease) both;
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: var(--cu-space-sm) var(--cu-space-md);
    margin-top: var(--cu-space-lg);
    max-width: 52rem;
    animation: cu-rise 900ms var(--cu-ease) both;
  }

  .hero__fact-label {
    font-size: var(--cu-step--2);
    color: var(--cu-bruma-300);
  }

  .hero__fact-value {
    margin: 0.15rem 0 0;
    font-family: var(--cu-font-text);
    font-size: var(--cu-step-0);
    color: var(--cu-hueso-soft);
  }

  .hero__cue {
    display: flex;
    align-items: center;
    gap: var(--cu-space-2xs);
    margin-top: var(--cu-space-xl);
    font-size: var(--cu-step--1);
    color: var(--cu-bruma-200);
    animation: cu-rise 900ms var(--cu-ease) 1500ms both;
  }

  /* A small chevron, drawn with borders so nothing here is a 1px rule. */
  .hero__cue-arrow {
    width: 0.6rem;
    height: 0.6rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    animation: cu-cue 2600ms var(--cu-ease) 1900ms infinite;
  }

  /* -- Motion --------------------------------------------------------------
     Only transform and opacity move. If an animation never runs, its element
     is simply at rest; nothing is hidden by CSS. */

  @keyframes cu-collage-in {
    from {
      opacity: 0;
      transform: translate3d(0, 1rem, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes cu-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 1.5rem, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes cu-drift {
    from {
      transform: scale(1.07) translate3d(-1.4%, 1%, 0);
    }
    to {
      transform: scale(1.15) translate3d(1.4%, -1%, 0);
    }
  }

  @keyframes cu-cue {
    0%,
    100% {
      transform: rotate(45deg) translate(0, 0);
      opacity: 0.5;
    }
    50% {
      transform: rotate(45deg) translate(0.15rem, 0.15rem);
      opacity: 1;
    }
  }

  /* -- Narrow screens: the collage becomes a contact sheet -----------------
     On a phone the mosaic is too small to hold a caption over a picture, so the
     band reflows to two columns and every caption sits *below* its image, where
     it is legible and credited. The interior maps fall away to keep the opening
     short; they remain in the document and in the colophon. */
  @media (max-width: 48rem) {
    .hero__collage {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      height: auto;
      min-height: 0;
    }

    .cell {
      grid-area: auto;
    }

    .cell--living {
      grid-column: 1 / -1;
    }

    .cell--guiana-sanson,
    .cell--venezuela-pinkerton,
    .cell--monagas,
    .cell--buja {
      display: none;
    }

    .cell__img {
      position: static;
      inset: auto;
      width: 100%;
      height: auto;
      aspect-ratio: 2 / 1;
    }

    .cell--living .cell__img {
      aspect-ratio: 16 / 9;
    }

    .cell__caption {
      position: static;
      padding-inline: 0;
      padding-block: var(--cu-space-2xs) var(--cu-space-sm);
    }

    .cell .u-scrim {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .hero__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--cu-space-xs);
    }
  }

  /* No motion: no droplets, no travel, no drift. Every letter is present and
     still, and the collage holds one frame. */
  @media (prefers-reduced-motion: reduce) {
    .hero__collage,
    .hero__full-title,
    .hero__epithet,
    .hero__standfirst,
    .hero__facts,
    .hero__cue,
    .hero__cue-arrow,
    .cell--living .cell__img {
      animation: none !important;
    }

    .l::before {
      display: none;
    }

    .cell--living .cell__img {
      will-change: auto;
    }
  }
</style>
