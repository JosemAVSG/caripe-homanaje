---
import { families, levels } from '../content/familias';

/**
 * Familias — one card per family, and a horizontal timeline behind each.
 *
 * The panel is a native `<dialog>`:
 *   · the static HTML ships it `open`, so with no JavaScript the reader simply
 *     finds the timelines in the flow of the page — nothing is hidden by CSS;
 *   · the script closes it and hands the work to `showModal()`, which brings
 *     the backdrop, the focus trap and Esc for free.
 *
 * Nothing inside the dialog carries `[data-reveal]`: those are staged by GSAP
 * from their position in the page, and a modal is not in the page.
 *
 * Interface copy is Spanish; code, comments and filenames are English.
 */
const levelKeys = Object.keys(levels) as Array<keyof typeof levels>;
---

<section class="familias" id="familias" data-scene data-time="Familias">
  <div class="familias__inner u-container">
    <header class="familias__header" data-reveal-group>
      <h2 class="familias__title" data-reveal>Familias</h2>
      <p class="familias__lede" data-reveal>
        Familias de las que hay noticia en Caripe. Cada una abre su propia
        cronología: una línea de tiempo horizontal que se recorre deslizando de
        izquierda a derecha.
      </p>
      <p class="familias__note" data-reveal>
        La mayoría de los hitos son tradición oral (nivel b). No se han hallado
        respaldos documentales para las fechas familiares. El nivel (a) solo
        alcanzaría al contexto regional, nunca a una fecha de familia. Aquí se
        dice explícitamente lo que no está respaldado.
      </p>
    </header>

    <ul class="familias__list">
      {
        families.map((family) => (
          <li class="familia" data-reveal>
            <button
              type="button"
              class="familia__button"
              data-family-open={`timeline-${family.id}`}
              aria-expanded="false"
              aria-controls={`timeline-${family.id}`}
            >
              <span class="familia__name">{family.name}</span>
              <span class="familia__meta">
                {family.origin ? `Origen atribuido: ${family.origin}` : 'Origen no documentado'}
              </span>
              <span class="familia__meta">
                {family.milestones.length} hitos · todos nivel b (tradición oral o indicio)
              </span>
              <span class="familia__action">Abrir la cronología horizontal</span>
            </button>
            {family.notes ? <p class="familia__notes">{family.notes}</p> : null}
          </li>
        ))
      }
    </ul>
  </div>

  {
    families.map((family) => (
      <dialog
        class="timeline"
        id={`timeline-${family.id}`}
        data-timeline
        aria-labelledby={`timeline-title-${family.id}`}
        open
      >
        <header class="timeline__header">
          <div>
            <h3 class="timeline__title" id={`timeline-title-${family.id}`}>
              {family.name}
            </h3>
            <p class="timeline__subtitle">Cronología horizontal</p>
          </div>
          <button type="button" class="timeline__close" data-timeline-close>
            Cerrar
          </button>
        </header>

        <div
          class="timeline__scroller"
          data-lenis-prevent
          tabindex="0"
          role="group"
          aria-label="Cronología horizontal. Se recorre con las flechas del teclado o deslizando."
        >
          <ol class="track">
            {family.milestones.map((milestone) => (
              <li class="event" data-level={milestone.level}>
                <span class="event__node" aria-hidden="true" />
                <p class="event__year">{milestone.year ?? 'Sin fecha'}</p>
                <p class="event__text">{milestone.event}</p>
                <p class="event__level">
                  Nivel {milestone.level} · {levels[milestone.level]}
                </p>
                {milestone.source ? (
                  <p class="event__source">Fuente: {milestone.source}</p>
                ) : null}
                {milestone.uncertainty ? (
                  <p class="event__uncertainty">Incertidumbre: {milestone.uncertainty}</p>
                ) : null}
              </li>
            ))}
          </ol>
        </div>

        <footer class="timeline__footer">
          <ul class="legend">
            {levelKeys.map((key) => (
              <li>
                <span class="legend__key">({key})</span> {levels[key]}
              </li>
            ))}
          </ul>
          <p class="timeline__note">
            Los siete hitos son nivel b: tradición oral o indicio sin respaldo
            documental. Cuando la fuente es Wikipedia sin cita, así se indica.
          </p>
        </footer>
      </dialog>
    ))
  }
</section>

<script>
  /**
   * Progressive enhancement. The markup already ships the timelines `open` and
   * in the flow, so the script only upgrades them: it closes them and opens them
   * as modal dialogs, which brings the backdrop, the focus trap and Esc with no
   * hand-rolled trap. If `showModal` is missing, nothing is touched and the
   * reader keeps the in-flow version.
   */
  function initFamilies(): void {
    const dialogs = Array.from(document.querySelectorAll<HTMLDialogElement>('[data-timeline]'));
    if (!dialogs.length) return;

    // Without `showModal` there is no modal to speak of, and the in-flow markup
    // is the better document: leave every dialog exactly as it shipped.
    if (typeof HTMLDialogElement.prototype.showModal !== 'function') return;

    const scrollStep = (scroller: HTMLElement) => scroller.clientWidth * 0.8;

    for (const dialog of dialogs) {
      // The element ships `open` so it is readable without a script; from here
      // the user agent decides (`display: none` until it is shown).
      dialog.removeAttribute('open');

      const trigger = document.querySelector<HTMLElement>(`[data-family-open="${dialog.id}"]`);
      const scroller = dialog.querySelector<HTMLElement>('.timeline__scroller');
      const events = Array.from(dialog.querySelectorAll<HTMLElement>('.event'));

      /**
       * Writes `--event-o` (0 → 1) on each event from where THAT event is in
       * the visible window right now.
       *
       * Deliberately not a global progress split by index: on this page that
       * approach measured elements at full attention rendering at half
       * opacity, and the last one never arriving at all. Here an event is
       * measured on its own, fully revealed a short way inside the reading
       * edge, and then held at exactly 1 for as long as it is on screen. It is
       * the same contract `motion.ts` keeps for a beat.
       */
      const revealEvents = (): void => {
        if (!scroller || !events.length) return;

        const view = scroller.getBoundingClientRect();
        const travel = Math.min(320, Math.max(140, view.width * 0.22));

        for (const event of events) {
          const offset = event.getBoundingClientRect().left - view.right;
          const progress = offset >= 0 ? 0 : Math.min(1, -offset / travel);
          event.style.setProperty('--event-o', progress.toFixed(4));
        }
      };

      trigger?.addEventListener('click', () => {
        dialog.showModal();
        trigger.setAttribute('aria-expanded', 'true');
        // The dialog was `display: none` a moment ago, so every child measured
        // as zero. Measure it now that it is really on screen.
        revealEvents();
      });

      for (const button of dialog.querySelectorAll('[data-timeline-close]')) {
        button.addEventListener('click', () => dialog.close());
      }

      // Clicking the backdrop closes. The backdrop is painted by the dialog's
      // own box, so a hit test against the element itself is the check.
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      // Escape fires `cancel` first and then `close`, so the focus hand-back
      // lives here, where the dialog is already gone and nothing overrides it.
      dialog.addEventListener('close', () => {
        trigger?.setAttribute('aria-expanded', 'false');
        trigger?.focus();
      });

      // The rail is a scroll container, and the only thing that moves the
      // events is the reader's own horizontal scroll inside it: the page's
      // scroll is never taken over.
      scroller?.addEventListener('scroll', revealEvents, { passive: true });
      if (scroller) new ResizeObserver(revealEvents).observe(scroller);

      // The arrows move the rail, and a reader who asked for no motion gets an
      // instant jump.
      scroller?.addEventListener('keydown', (event) => {
        const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ? 'auto'
          : 'smooth';
        const step = scrollStep(scroller);

        if (event.key === 'ArrowRight') {
          scroller.scrollBy({ left: step, behavior });
          event.preventDefault();
        } else if (event.key === 'ArrowLeft') {
          scroller.scrollBy({ left: -step, behavior });
          event.preventDefault();
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFamilies);
  } else {
    initFamilies();
  }
</script>

<style>
  .familias {
    position: relative;
    padding-block: var(--cu-chapter-gap);
    background-color: var(--cu-scene-monte);
    scroll-margin-top: 2rem;
  }

  .familias__header {
    margin-bottom: var(--cu-space-lg);
  }

  .familias__title {
    margin-bottom: var(--cu-space-sm);
    font-family: var(--cu-font-display);
    font-size: var(--cu-step-5);
    font-weight: 400;
    line-height: var(--cu-leading-tight);
    letter-spacing: var(--cu-tracking-display);
    color: var(--cu-hueso);
  }

  .familias__lede {
    max-width: 44rem;
    margin-bottom: var(--cu-space-sm);
    font-family: var(--cu-font-serif);
    font-size: var(--cu-step-1);
    line-height: var(--cu-leading-body);
    color: var(--cu-text-muted);
  }

  .familias__note {
    max-width: 52rem;
    padding-left: var(--cu-space-sm);
    border-left: 3px solid var(--cu-accent-deep);
    font-family: var(--cu-font-serif);
    font-size: var(--cu-step--1);
    line-height: var(--cu-leading-body);
    color: var(--cu-bruma-300);
  }

  .familias__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--cu-space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .familia {
    display: flex;
    flex-direction: column;
    background-color: color-mix(in srgb, var(--cu-scene-monte) 62%, var(--cu-monte-700));
  }

  .familia__button {
    display: flex;
    flex-direction: column;
    gap: var(--cu-space-3xs);
    width: 100%;
    padding: var(--cu-space-md);
    border: 0;
    background-color: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .familia__button:focus-visible {
    outline: 2px solid var(--cu-focus);
    outline-offset: 3px;
  }

  .familia__name {
    font-family: var(--cu-font-display);
    font-size: var(--cu-step-2);
    line-height: var(--cu-leading-snug);
    color: var(--cu-hueso);
  }

  .familia__meta {
    font-family: var(--cu-font-serif);
    font-size: var(--cu-step--2);
    color: var(--cu-bruma-300);
  }

  .familia__action {
    margin-top: var(--cu-space-2xs);
    font-size: var(--cu-step--2);
    color: var(--cu-accent-soft);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .familia__notes {
    padding: 0 var(--cu-space-md) var(--cu-space-md);
    font-family: var(--cu-font-serif);
    font-size: var(--cu-step--2);
    line-height: var(--cu-leading-body);
    color: var(--cu-bruma-400);
  }

  /* -- The dialog --------------------------------------------------------- */

  /* In flow, for the reader without a script. `:modal` is the real case. */
  .timeline {
    position: static;
    width: min(74rem, calc(100% - 2rem));
    max-height: min(88svh, 60rem);
    margin: auto;
    padding: var(--cu-space-md);
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 0;
    background-color: var(--cu-monte-800);
    color: var(--cu-hueso);
  }

  .timeline:modal {
    position: fixed;
    inset: 0;
  }

  .timeline::backdrop {
    background-color: color-mix(in srgb, var(--cu-monte-950) 88%, transparent);
  }

  .timeline__header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cu-space-sm);
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--cu-space-2xs);
  }

  .timeline__title {
    font-family: var(--cu-font-display);
    font-size: var(--cu-step-3);
    font-weight: 400;
    line-height: var(--cu-leading-snug);
    color: var(--cu-hueso);
  }

  .timeline__subtitle {
    font-family: var(--cu-font-serif);
    font-size: var(--cu-step--1);
    color: var(--cu-bruma-300);
  }

  .timeline__close {
    padding: var(--cu-space-3xs) var(--cu-space-2xs);
    border: 0;
    background-color: transparent;
    color: var(--cu-accent-soft);
    font-family: inherit;
    font-size: var(--cu-step--1);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    cursor: pointer;
  }

  .timeline__close:focus-visible {
    outline: 2px solid var(--cu-focus);
    outline-offset: 3px;
  }

  /* -- The horizontal rail ------------------------------------------------ */

  .timeline__scroller {
    padding-block: var(--cu-space-lg) var(--cu-space-md);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-color: var(--cu-accent-deep) transparent;
  }

  .timeline__scroller:focus-visible {
    outline: 2px solid var(--cu-focus);
    outline-offset: 2px;
  }

  .track {
    position: relative;
    display: flex;
    gap: var(--cu-space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Every event hangs from the rule: the connector is half a gap wide on each
     side of its node, so the rail reads as one line under the whole row. */
  .event {
    position: relative;
    flex: 0 0 auto;
    width: 17rem;
    padding-top: var(--cu-space-md);
    scroll-snap-align: start;
  }

  .event::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: calc(-1 * var(--cu-space-lg));
    height: 2px;
    background-color: color-mix(in srgb, var(--cu-accent) 55%, transparent);
  }

  .track .event:last-child::before {
    right: 0;
  }

  /* Each event is revealed from its OWN place on screen (`--event-o`, written
     per element by the script above), and only while motion is on. With no
     script the variable is absent and the fallback keeps the whole rail
     visible; with reduced motion the attribute never becomes `on`. */
  :global(html[data-motion='on']) .event {
    opacity: var(--event-o, 1);
  }

  /* The connector is drawn: it grows in LENGTH with the event it belongs to.
     Never a colour change, never a gradient. */
  :global(html[data-motion='on']) .event::before {
    transform: scaleX(var(--event-o, 1));
    transform-origin: left center;
  }

  .event__node {
    position: absolute;
    top: -0.25rem;
    left: 0;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background-color: var(--cu-accent);
  }

  .event__year {
    margin-bottom: var(--cu-space-3xs);
    font-size: var(--cu-step--2);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--cu-accent-soft);
  }

  .event__text {
    font-family: var(--cu-font-serif);
    font-size: var(--cu-step--1);
    line-height: 1.6;
    color: var(--cu-hueso);
  }

  .event__level,
  .event__source,
  .event__uncertainty {
    margin-top: var(--cu-space-2xs);
    font-family: var(--cu-font-serif);
    font-size: var(--cu-step--2);
    line-height: 1.55;
  }

  .event__level {
    display: inline-block;
    padding: 0.15rem 0.45rem;
    color: var(--cu-accent-soft);
    background-color: color-mix(in srgb, var(--cu-accent-deep) 34%, transparent);
  }

  .event__source {
    color: var(--cu-bruma-300);
  }

  .event__uncertainty {
    padding-left: var(--cu-space-2xs);
    border-left: 3px solid color-mix(in srgb, var(--cu-bruma-300) 35%, transparent);
    color: var(--cu-bruma-400);
  }

  /* -- Footer inside the dialog ------------------------------------------- */

  .timeline__footer {
    padding-top: var(--cu-space-sm);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cu-space-sm);
    margin: 0 0 var(--cu-space-2xs);
    padding: 0;
    font-size: var(--cu-step--2);
    list-style: none;
    color: var(--cu-bruma-300);
  }

  .legend__key {
    color: var(--cu-accent-soft);
  }

  .timeline__note {
    max-width: 60ch;
    font-family: var(--cu-font-serif);
    font-size: var(--cu-step--2);
    line-height: 1.6;
    color: var(--cu-bruma-400);
  }

  @media (max-width: 47.99rem) {
    .timeline {
      width: calc(100% - 1rem);
      padding: var(--cu-space-sm);
    }

    .event {
      width: 15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline__scroller {
      scroll-behavior: auto;
      scroll-snap-type: none;
    }
  }
</style>
