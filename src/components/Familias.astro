---
import { families } from '../content/familias';

/**
 * Families and horizontal timelines.
 * Spanish UI labels, English in code/comments/filenames per project rules.
 */
---

<section class="familias" id="familias" data-scene data-time="Familias">
  <div class="familias__inner u-container">
    <header class="familias__header" data-reveal-group>
      <h2 class="familias__title" data-reveal>Familias</h2>
      <p class="familias__lede" data-reveal>
        Sistema de familias con líneas de tiempo horizontales. Solo se muestran los datos verificados del informe de investigación.
      </p>
      <p class="familias__disclaimer" data-reveal>
        La mayoría de los hitos son tradición oral (nivel b). No se han hallado respaldos documentales para las fechas familiares. Solo el contexto regional podría considerarse nivel (a); no se asumen fechas familiares. Cuando se indica &ldquo;Wikipedia sin cita&rdquo;, ello se marca explícitamente.
      </p>
    </header>

    <div class="familias__list" role="list">
      {families.map((family) => (
        <article class="familia-card" role="listitem" data-family-id={family.id}>
          <button
            type="button"
            class="familia-card__button"
            aria-expanded="false"
            aria-controls={`timeline-panel-${family.id}`}
            data-family-toggle
          >
            <div class="familia-card__header">
              <h3 class="familia-card__name">{family.name}</h3>
              <span class="familia-card__surnames">{family.surnames}</span>
            </div>
            {family.origin && <p class="familia-card__origin">Origen: {family.origin}</p>}
            {family.notes && <p class="familia-card__notes">{family.notes}</p>}
            <span class="familia-card__cta" aria-hidden="true">Ver línea de tiempo horizontal</span>
          </button>
        </article>
      ))}
    </div>
  </div>

  <!-- Timeline panels (modal-like behavior, inline for no-JS resilience) -->
  {families.map((family) => (
    <div
      id={`timeline-panel-${family.id}`}
      class="timeline-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby={`timeline-title-${family.id}`}
      aria-hidden="true"
      data-timeline-panel
      data-family-id={family.id}
    >
      <div class="timeline-panel__backdrop" data-timeline-close></div>
      <div class="timeline-panel__content" role="document" tabindex="-1">
        <header class="timeline-panel__header">
          <div>
            <h3 id={`timeline-title-${family.id}`} class="timeline-panel__title">
              {family.name} · Línea de tiempo horizontal
            </h3>
            <p class="timeline-panel__subtitle">{family.surnames}{family.origin ? ` · ${family.origin}` : ''}</p>
          </div>
          <button
            type="button"
            class="timeline-panel__close"
            aria-label="Cerrar línea de tiempo"
            data-timeline-close
          >
            Cerrar
          </button>
        </header>

        <div class="timeline-panel__legend" aria-label="Leyenda de niveles de fiabilidad">
          <span class="legend-item"><strong>(a)</strong> corroborado</span>
          <span class="legend-item"><strong>(b)</strong> tradición oral/indicio</span>
          <span class="legend-item"><strong>(c)</strong> sin fuente</span>
        </div>

        <div class="timeline-panel__body">
          <div class="h-timeline" role="region" aria-label="Línea de tiempo horizontal" data-horizontal-timeline>
            <div class="h-timeline__track" tabindex="0" role="list">
              {family.milestones.map((milestone, idx) => (
                <article class="h-timeline__event" role="listitem" data-reveal>
                  <div class="h-timeline__connector" aria-hidden="true"></div>
                  <div class="h-timeline__node" aria-hidden="true"></div>
                  <div class="h-timeline__content">
                    {milestone.year && <p class="h-timeline__year">{milestone.year} <span class="h-timeline__level">({milestone.level})</span></p>}
                    {!milestone.year && <p class="h-timeline__year">Sin fecha <span class="h-timeline__level">({milestone.level})</span></p>}
                    <p class="h-timeline__event-text">{milestone.event}</p>
                    {milestone.source && <p class="h-timeline__source">Fuente: {milestone.source}</p>}
                    {milestone.uncertainty && <p class="h-timeline__uncertainty">Incertidumbre: {milestone.uncertainty}</p>}
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>

        <div class="timeline-panel__footer">
          <p class="timeline-panel__note">
            * La mayoría son nivel b. El único nivel (a) posible es contexto regional, NO fechas familiares. Cuando dice &ldquo;Wikipedia sin cita&rdquo;, se indica explícitamente. No se muestran certezas donde no las hay.
          </p>
        </div>
      </div>
    </div>
  ))}
</section>

<script>
  // Minimal JS for opening/closing panel and focus management. Respects no-JS (panel remains in DOM; buttons still usable).
  function initFamilies() {
    const toggles = document.querySelectorAll('[data-family-toggle]');
    const panels = document.querySelectorAll('[data-timeline-panel]');

    function closePanel(panel) {
      panel.setAttribute('aria-hidden', 'true');
      panel.classList.remove('is-open');
      const id = panel.getAttribute('data-family-id');
      const toggle = document.querySelector(`[data-family-toggle][aria-controls="timeline-panel-${id}"]`);
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
      document.body.style.removeProperty('overflow');
    }

    function openPanel(panel) {
      panels.forEach((p) => closePanel(p));
      panel.setAttribute('aria-hidden', 'false');
      panel.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      const id = panel.getAttribute('data-family-id');
      const toggle = document.querySelector(`[data-family-toggle][aria-controls="timeline-panel-${id}"]`);
      if (toggle) toggle.setAttribute('aria-expanded', 'true');
      const content = panel.querySelector('.timeline-panel__content');
      if (content) content.focus();
    }

    toggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const targetId = toggle.getAttribute('aria-controls');
        const panel = document.getElementById(targetId);
        if (panel) {
          if (panel.getAttribute('aria-hidden') === 'true') openPanel(panel);
          else closePanel(panel);
        }
      });
    });

    panels.forEach((panel) => {
      panel.querySelectorAll('[data-timeline-close]').forEach((el) => {
        el.addEventListener('click', () => closePanel(panel));
      });

      panel.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closePanel(panel);
        }
      });
    });

    // Ensure keyboard accessibility for horizontal track (scroll with arrows).
    document.querySelectorAll('[data-horizontal-timeline]').forEach((tl) => {
      const track = tl.querySelector('.h-timeline__track');
      if (!track) return;
      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          track.scrollBy({ left: -200, behavior: 'smooth' });
        }
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          track.scrollBy({ left: 200, behavior: 'smooth' });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFamilies);
  } else {
    initFamilies();
  }
</script>

<style>
  .familias {
    position: relative;
    padding-block: var(--cu-chapter-gap);
    background-color: var(--cu-scene-monte);
    scroll-margin-top: 2rem;
  }

  .familias__header {
    margin-bottom: var(--cu-space-lg);
  }

  .familias__title {
    font-family: var(--cu-font-display);
    font-size: var(--cu-step-5);
    font-weight: 400;
    line-height: var(--cu-leading-tight);
    letter-spacing: var(--cu-tracking-display);
    color: var(--cu-text);
    margin-bottom: var(--cu-space-sm);
  }

  .familias__lede {
    font-family: var(--cu-font-serif);
    font-size: var(--cu-step-1);
    color: var(--cu-text-muted);
    line-height: var(--cu-leading-body);
    max-width: 42rem;
    margin-bottom: var(--cu-space-sm);
  }

  .familias__disclaimer {
    font-family: var(--cu-font-serif);
    font-size: var(--cu-step--1);
    color: var(--cu-text-muted);
    line-height: var(--cu-leading-body);
    max-width: 48rem;
    opacity: 0.9;
  }

  .familias__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--cu-space-md);
  }

  /* Defined by its fill, one tone step from the field it sits on: the house rule
     separates surfaces by tone, never by a rule. */
  .familia-card {
    background: color-mix(in srgb, var(--cu-surface) 72%, var(--cu-scene-monte));
  }

  .familia-card__button {
    width: 100%;
    text-align: left;
    padding: var(--cu-space-md);
    background: transparent;
    border: none;
    color: var(--cu-text);
    font: inherit;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: var(--cu-space-2xs);
  }

  .familia-card__button:focus-visible {
    outline: 2px solid var(--cu-focus);
    outline-offset: 2px;
  }

  .familia-card__header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
  }

  .familia-card__name {
    font-family: var(--cu-font-display);
    font-size: var(--cu-step-2);
    font-weight: 400;
    line-height: var(--cu-leading-snug);
  }

  .familia-card__surnames {
    font-family: var(--cu-font-serif);
    font-size: var(--cu-step--1);
    color: var(--cu-text-muted);
  }

  .familia-card__origin,
  .familia-card__notes {
    font-family: var(--cu-font-serif);
    font-size: var(--cu-step--1);
    color: var(--cu-text-muted);
    line-height: var(--cu-leading-body);
  }

  .familia-card__cta {
    margin-top: var(--cu-space-2xs);
    font-size: var(--cu-step--2);
    color: var(--cu-accent-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Timeline panel */
  .timeline-panel {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: center;
    padding: var(--cu-space-md);
  }

  .timeline-panel.is-open {
    display: flex;
  }

  .timeline-panel[aria-hidden="false"] {
    display: flex;
  }

  .timeline-panel__backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--cu-bg) 90%, transparent);
  }

  .timeline-panel__content {
    position: relative;
    width: min(1200px, 100%);
    max-height: 90vh;
    overflow-y: auto;
    background: var(--cu-monte-800);
    padding: var(--cu-space-md);
    display: flex;
    flex-direction: column;
    gap: var(--cu-space-md);
    outline: none;
  }

  .timeline-panel__content:focus-visible {
    outline: 2px solid var(--cu-focus);
    outline-offset: 2px;
  }

  .timeline-panel__header {
    display: flex;
    justify-content: space-between;
    gap: var(--cu-space-md);
    align-items: flex-start;
  }

  .timeline-panel__title {
    font-family: var(--cu-font-display);
    font-size: var(--cu-step-3);
    font-weight: 400;
    line-height: var(--cu-leading-snug);
    color: var(--cu-text);
  }

  .timeline-panel__subtitle {
    font-family: var(--cu-font-serif);
    font-size: var(--cu-step--1);
    color: var(--cu-text-muted);
    margin-top: var(--cu-space-3xs);
  }

  .timeline-panel__close {
    background: transparent;
    color: var(--cu-accent-soft);
    padding: var(--cu-space-2xs) var(--cu-space-sm);
    font: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .timeline-panel__close:focus-visible {
    outline: 2px solid var(--cu-focus);
    outline-offset: 2px;
  }

  .timeline-panel__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cu-space-sm);
    font-size: var(--cu-step--2);
    color: var(--cu-text-muted);
  }

  .timeline-panel__body {
    overflow-x: auto;
  }

  /* Horizontal timeline */
  .h-timeline {
    position: relative;
    padding-block: var(--cu-space-md);
  }

  .h-timeline__track {
    display: flex;
    gap: var(--cu-space-lg);
    overflow-x: auto;
    overflow-y: hidden;
    padding-inline: var(--cu-space-sm);
    scroll-behavior: smooth;
    min-width: 0;
  }

  .h-timeline__track:focus-visible {
    outline: 2px solid var(--cu-focus);
    outline-offset: 2px;
  }

  .h-timeline__event {
    position: relative;
    min-width: 16rem;
    max-width: 20rem;
    flex-shrink: 0;
    padding-top: var(--cu-space-md);
  }

  .h-timeline__connector {
    position: absolute;
    top: 0.375rem;
    left: 0;
    right: calc(-1 * var(--cu-space-lg));
    height: 2px;
    background: color-mix(in srgb, var(--cu-accent) 70%, transparent);
  }

  .h-timeline__node {
    position: absolute;
    top: 0.125rem;
    left: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--cu-accent);
  }

  .h-timeline__content {
    display: flex;
    flex-direction: column;
    gap: var(--cu-space-3xs);
  }

  .h-timeline__year {
    font-size: var(--cu-step--2);
    font-weight: 600;
    color: var(--cu-accent-soft);
  }

  .h-timeline__level {
    color: var(--cu-text-muted);
    font-weight: 400;
  }

  .h-timeline__event-text {
    font-family: var(--cu-font-serif);
    font-size: var(--cu-step--1);
    color: var(--cu-text);
    line-height: var(--cu-leading-body);
  }

  .h-timeline__source,
  .h-timeline__uncertainty {
    font-family: var(--cu-font-serif);
    font-size: var(--cu-step--2);
    color: var(--cu-text-muted);
    line-height: var(--cu-leading-body);
  }

  .timeline-panel__footer {
    padding-top: var(--cu-space-sm);
  }

  .timeline-panel__note {
    font-size: var(--cu-step--2);
    color: var(--cu-text-muted);
    line-height: var(--cu-leading-body);
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .h-timeline__track {
      scroll-behavior: auto;
    }
  }

  /* Responsive */
  @media (max-width: 47.99rem) {
    .h-timeline__event {
      min-width: 14rem;
      max-width: 18rem;
    }
  }
</style>
