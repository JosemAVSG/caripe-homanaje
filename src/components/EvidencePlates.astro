---
import { Image } from 'astro:assets';
import type { EvidencePlate } from '../content/types';
import { getPhoto } from '../content/photos';
import PhotoCreditLine from './PhotoCreditLine.astro';

/**
 * Historical documents, staged as evidence.
 *
 * These are the oldest things on the site — a lithograph, an engraved plate, a
 * 19th-century print — and they are treated as documents rather than pictures:
 * a flat paper-toned field behind the sheet, a plain date line, and the plate
 * itself left uncropped so the annotation around it stays legible.
 *
 * The paper is a single flat colour, not a gradient; the frame carries no
 * border and no shadow. The documents are separated from the page by a step in
 * tone, which is the house rule for surfaces.
 */
interface Props {
  plates: EvidencePlate[];
}

const { plates } = Astro.props;

const sizes = '(min-width: 62rem) 19rem, (min-width: 34rem) 44vw, 88vw';
---

<section class="plates" aria-label="Evidencia histórica" data-reveal>
  <p class="plates__label u-label">Evidencia histórica</p>

  <ul class="plates__list">
    {
      plates.map((plate) => {
        const photo = getPhoto(plate.photo);
        const isVector = photo.src.format === 'svg';

        return (
          <li class="plates__item">
            <figure class="plate">
              <div class="plate__frame">
                {isVector ? (
                  <img
                    class="plate__image"
                    src={photo.src.src}
                    width={photo.src.width}
                    height={photo.src.height}
                    alt={plate.alt}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <Image
                    class="plate__image"
                    src={photo.src}
                    alt={plate.alt}
                    widths={[420, 760]}
                    sizes={sizes}
                    format="webp"
                    quality={76}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>

              <figcaption class="plate__caption">
                {plate.label ? <span class="plate__tag">{plate.label}</span> : null}
                <span class="plate__text">{plate.caption}</span>
                <PhotoCreditLine credit={photo.credit} />
              </figcaption>
            </figure>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .plates {
    margin-top: var(--cu-space-xl);
  }

  .plates__label {
    margin-bottom: var(--cu-space-md);
  }

  .plates__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: var(--cu-space-lg) var(--cu-space-md);
  }

  @media (min-width: 34rem) {
    .plates__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .plates__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .plate {
    margin: 0;
    min-width: 0;
  }

  /* Paper, not screen: the documents come from another century. A single flat
     bone field, one step from the page: no gradient, no border, no shadow. */
  .plate__frame {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(0.6rem, 1.6vw, 1rem);
    background-color: color-mix(in srgb, var(--cu-hueso) 86%, var(--cu-cafe-400));
  }

  .plate__image {
    display: block;
    width: 100%;
    height: auto;
    filter: saturate(0.92) contrast(1.02);
  }

  .plate__caption {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: var(--cu-space-sm);
  }

  .plate__tag {
    font-size: var(--cu-step--2);
    font-weight: 600;
    color: var(--cu-accent-soft);
  }

  .plate__text {
    font-size: var(--cu-step--1);
    font-weight: 300;
    line-height: 1.65;
    color: var(--cu-text-muted);
    text-wrap: pretty;
  }
</style>
