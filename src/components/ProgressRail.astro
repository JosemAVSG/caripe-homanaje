---
import type { Chapter } from '../content/types';

/**
 * A vertical reading rail, shown from 1024px up.
 *
 * It doubles as chapter navigation and as the progress indicator: the track
 * fills with the scroll and the active chapter is marked. It carries no
 * numerals — order is shown by position, and each link names its chapter for
 * assistive technology. Below 1024px the rail is hidden and the thin top
 * progress bar takes over (see `global.css`), so the reading signal is never
 * lost, only simplified.
 */
interface Props {
  chapters: Chapter[];
}

const { chapters } = Astro.props;
---

<nav class="rail" aria-label="Capítulos">
  <div class="rail__track">
    <span class="rail__fill" aria-hidden="true" data-rail-fill></span>

    <ol class="rail__list">
      {
        chapters.map((chapter) => (
          <li class="rail__item">
            <a
              class="rail__link"
              href={`#${chapter.slug}`}
              data-rail-link={chapter.slug}
              aria-label={chapter.title}
            >
              <span class="rail__dot" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</nav>

<style>
  .rail {
    position: fixed;
    top: 50%;
    right: clamp(1rem, 2.4vw, 2rem);
    z-index: 50;
    display: none;
    transform: translateY(-50%);
  }

  .rail__track {
    position: relative;
    padding-left: 1.15rem;
  }

  /* The rail's own axis, drawn as a real bar (3px), not a hairline. */
  .rail__track::before {
    content: '';
    position: absolute;
    inset: 0.45rem auto 0.45rem 0;
    width: 3px;
    background-color: color-mix(in srgb, var(--cu-bruma-400) 34%, transparent);
  }

  /* Scroll-driven fill, layered over the axis. Starts empty: with no
     JavaScript there is no progress to report, and faking a full bar would
     be a lie. */
  .rail__fill {
    position: absolute;
    top: 0.45rem;
    left: 0;
    width: 3px;
    height: calc(100% - 0.9rem);
    background-color: var(--cu-accent);
    transform: scaleY(0);
    transform-origin: top center;
  }

  .rail__list {
    display: grid;
    gap: var(--cu-space-sm);
  }

  .rail__item {
    position: relative;
  }

  .rail__link {
    display: flex;
    align-items: center;
    min-height: 1.5rem;
    text-decoration: none;
    color: var(--cu-text-faint);
  }

  /* Sits exactly on the axis. */
  .rail__dot {
    position: absolute;
    left: calc(1.15rem * -1 - 2.5px);
    width: 8px;
    height: 8px;
    background-color: var(--cu-bg);
    border: 2px solid color-mix(in srgb, var(--cu-bruma-300) 50%, transparent);
    border-radius: 50%;
    transition:
      background-color var(--cu-dur) var(--cu-ease),
      border-color var(--cu-dur) var(--cu-ease);
  }

  .rail__link:hover {
    color: var(--cu-hueso);
  }

  /* Active chapter, driven by ScrollTrigger. */
  .rail__link[aria-current='true'] {
    color: var(--cu-accent-soft);
  }

  .rail__link[aria-current='true'] .rail__dot {
    background-color: var(--cu-accent);
    border-color: var(--cu-accent-soft);
    outline: 3px solid color-mix(in srgb, var(--cu-accent) 22%, transparent);
    outline-offset: 1px;
  }

  @media (min-width: 1024px) {
    .rail {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail__dot {
      transition: none;
    }
  }
</style>
