---
import { Image } from 'astro:assets';
import type { Chapter, ChapterLayout } from '../content/types';
import Beat from './Beat.astro';
import ChapterGallery from './ChapterGallery.astro';
import ChapterStory from './ChapterStory.astro';
import ChapterTimeline from './ChapterTimeline.astro';
import CloudBanks from './CloudBanks.astro';
import CoffeeBranches from './CoffeeBranches.astro';
import EvidencePlates from './EvidencePlates.astro';
import ForkedRoad from './ForkedRoad.astro';
import FormingText from './FormingText.astro';
import FullBleedImage from './FullBleedImage.astro';
import LexiconPlate from './LexiconPlate.astro';
import PhotoSlot from './PhotoSlot.astro';
import PhotoCreditLine from './PhotoCreditLine.astro';
import SourceNote from './SourceNote.astro';
import { getPhoto } from '../content/photos';
import { site } from '../content/site';
import { reservedPhotos } from '../content/layout';

/**
 * One chapter, staged as a sequence of full-screen scenes.
 *
 *   scene__cover   — the chapter's photograph holding the WHOLE screen, with
 *                    the title set over it. It is `position: sticky`, so it
 *                    stays put (behind everything that follows) with the fog
 *                    drifting over it;
 *   scene__hold    — empty scroll distance: the cover is held while it breathes;
 *   scene__content — the narration, evidence and sources on a solid field. It
 *                    scrolls UP OVER the held cover like a curtain;
 *   reel           — the rest of the chapter's photographs, one full screen
 *                    each, every one covering the one before it
 *                    (`ChapterGallery.astro`).
 *
 * The holding and the curtain are pure CSS; `src/scripts/motion.ts` only adds
 * depth (zoom, dim, parallax) by scrubbing. With no script, or with reduced
 * motion, every screen is simply a full-screen photograph followed by text.
 *
 * A chapter with no photograph yet opens on a full-height typographic panel
 * instead, so the rhythm of full screens survives without a stand-in image.
 *
 * Scroll progress through the chapter is still published as `--p` (0 → 1);
 * with no JavaScript it stays at its declared 1.
 */
interface Props {
  chapter: Chapter;
}

const { chapter } = Astro.props;
const {
  slug,
  title,
  kicker,
  lede,
  tone = 'monte',
  layout: chapterLayout,
  decor,
  beats,
  statement,
  lexicon,
  timeline,
  plates,
  gallery,
  aside,
  photo,
  sources,
  pending,
  pendingNote,
} = chapter;

/**
 * The composition. `stage` is the original geometry and the default, so a
 * chapter that names no layout is unchanged; `band`, `mist` and `fork` are
 * three other geometries, selected below by class and grid.
 */
const layout: ChapterLayout = chapterLayout ?? 'stage';
const isStage = layout === 'stage';

const titleId = `${slug}-title`;
const hasBeats = beats.length > 0;
const hasStatement = Boolean(statement);
const hasTimeline = Boolean(timeline && timeline.length > 0);
const hasPlates = Boolean(plates && plates.length > 0);

// The hero and the full-bleed band take one photograph each; those never appear
// again here, so no picture is shown twice on the page.
const reserved = new Set(reservedPhotos);
const allImages = (gallery?.images ?? []).filter((image) => !reserved.has(image.photo));

// The stage carries one large photograph per chapter: the first remaining
// `feature` image, or the first image left. It then leaves the grid.
const stageImage = allImages.find((image) => image.layout === 'feature') ?? allImages[0] ?? null;
const restImages = stageImage ? allImages.filter((image) => image !== stageImage) : allImages;
const hasGallery = restImages.length > 0;
const stagePhoto = stageImage ? getPhoto(stageImage.photo) : null;
const hasCover = Boolean(stagePhoto && stageImage);

// With a cover, beats and photographs to spare, the narration is told ON the
// photographs (`ChapterStory`) instead of in a column on a solid field. A
// chapter without photographs, or without beats, keeps the plain composition.
const isStory = hasCover && hasBeats && hasGallery;
const asideFigures = (aside ?? []).map((image) => ({ image, photo: getPhoto(image.photo) }));

// Fog density is a design decision about this chapter's weather, not a claim
// about Caripe: the cave chapter is nearly fogless, the mountain chapters are
// the foggiest. Kept out of the content model on purpose.
const FOG: Record<string, 'none' | 'light' | 'dense'> = {
  'chapter-1-1799': 'none',
  'chapter-2-cafe': 'dense',
  'chapter-3-neblina': 'dense',
  'chapter-4-turismo': 'light',
  'chapter-5-cuadros-vivos': 'light',
  'chapter-6-partir': 'light',
};
const fog = FOG[slug] ?? 'light';
---

<section
  class:list={['scene', `scene--${tone}`, hasCover ? 'scene--cover' : 'scene--opener', isStory && 'scene--story', pending && 'scene--pending', !isStage && `scene--layout-${layout}`]}
  {...(!isStage ? { 'data-layout': layout } : {})}
  id={slug}
  data-scene
  data-chapter={slug}
  data-time={title}
  style="--p:1"
  aria-labelledby={titleId}
>
  {
    stagePhoto && stageImage ? (
      <>
        <figure class="scene__cover" data-cover data-stage>
          <div class="scene__cover-media" data-cover-media>
            <FullBleedImage src={stagePhoto.src} alt={stageImage.alt} sizes="100vw" />
          </div>
          <div class="u-scrim u-scrim--deep" aria-hidden="true" />
          <canvas
            class="scene__fog"
            data-fog={fog}
            data-fog-tone={tone === 'bruma' ? 'cold' : 'neutral'}
            aria-hidden="true"
          />
          <div class="scene__veil" data-cover-veil aria-hidden="true" />

          <header class="scene__header scene__header--cover" data-cover-title>
            <p class="scene__number" aria-hidden="true">{chapter.number}</p>
            <h2 class="scene__title" id={titleId}>{title}</h2>
            {kicker ? <p class="scene__subtitle">{kicker}</p> : null}
            {lede ? <p class="scene__lede">{lede}</p> : null}
          </header>

          <figcaption class="scene__cover-caption">
            <span class="scene__cover-text">{stageImage.caption}</span>
            <PhotoCreditLine credit={stagePhoto.credit} />
          </figcaption>
        </figure>
        <div class="scene__hold" data-cover-hold aria-hidden="true" />
      </>
    ) : null
  }

  {isStory ? <ChapterStory beats={beats} images={restImages} label={gallery?.label} /> : null}

  <div class="scene__content" data-content>
    {decor === 'coffee-branches' ? <CoffeeBranches /> : null}
    {decor === 'cloud-banks' ? <CloudBanks /> : null}
    {decor === 'forked-road' ? <ForkedRoad /> : null}

    {
      !hasCover ? (
        <header class="scene__header scene__header--opener u-container" data-reveal-group>
          <p class="scene__number" aria-hidden="true">{chapter.number}</p>
          <h2 class="scene__title" id={titleId} data-reveal>{title}</h2>
          {kicker ? <p class="scene__subtitle" data-reveal>{kicker}</p> : null}
          {lede ? <p class="scene__lede" data-reveal>{lede}</p> : null}
        </header>
      ) : null
    }

    <div class="scene__inner u-container">
      {
        statement ? (
          <figure class="scene__statement">
            <blockquote class="scene__statement-quote">
              <FormingText
                as="p"
                class="scene__statement-text"
                text={statement.text}
                start={0.06}
                spread={0.68}
                dur={0.28}
              />
            </blockquote>
            {statement.attribution || statement.placeholder ? (
              <figcaption class="scene__statement-caption">
                {statement.attribution ? <span>{statement.attribution}</span> : null}
                {statement.placeholder ? <span>voz preliminar</span> : null}
              </figcaption>
            ) : null}
          </figure>
        ) : null
      }

      <div class="scene__body" data-reveal-group>
        {hasPlates ? <EvidencePlates plates={plates!} /> : null}

        {
          pending ? (
            <div class="scene__pending" data-reveal>
              <p class="scene__pending-note">{pendingNote}</p>
            </div>
          ) : null
        }

        {
          hasBeats && !isStory ? (
            <div class="scene__narration">
              {beats.map((beat) => (
                <Beat beat={beat} />
              ))}
            </div>
          ) : null
        }

        {
          lexicon ? (
            <aside class="scene__evidence" aria-label="Evidencia del capítulo">
              <LexiconPlate entry={lexicon} />
            </aside>
          ) : null
        }

        {hasTimeline ? <ChapterTimeline milestones={timeline!} /> : null}

        {photo ? <PhotoSlot slot={photo} /> : null}

        <SourceNote sources={sources} note={site.sourceFootnote} />
      </div>

      {
        asideFigures.length > 0 ? (
          <div class="scene__aside" data-reveal-group>
            {asideFigures.map(({ image, photo: asidePhoto }) => (
              <figure class="scene__aside-figure">
                <Image
                  class="scene__aside-image"
                  src={asidePhoto.src}
                  alt={image.alt}
                  widths={[360, 540, 720]}
                  sizes="(min-width: 64rem) 14rem, 100vw"
                  format="webp"
                  quality={74}
                  loading="lazy"
                  decoding="async"
                  data-reveal
                />
                <figcaption class="scene__aside-caption">
                  <span>{image.caption}</span>
                  <PhotoCreditLine credit={asidePhoto.credit} />
                </figcaption>
              </figure>
            ))}
          </div>
        ) : null
      }
    </div>
  </div>

  {hasGallery && !isStory ? <ChapterGallery gallery={{ label: gallery!.label, images: restImages }} /> : null}
</section>

<style>
  .scene {
    position: relative;
    scroll-margin-top: 0;
  }

  /* -- The cover: a photograph that holds the whole screen ------------------ */

  .scene__cover {
    position: sticky;
    top: 0;
    z-index: 0;
    margin: 0;
    height: 100svh;
    overflow: hidden;
    background-color: var(--cu-monte-900);
  }

  .scene__cover-media {
    position: absolute;
    inset: 0;
    will-change: transform;
  }

  .scene__cover :global(.u-scrim) {
    z-index: 1;
  }

  /* The fog canvas paints over the photograph and under the words. */
  .scene__fog {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Darkens the held cover as the text rises over it. Scrubbed by motion.ts;
     transparent at rest, so nothing is hidden without script. */
  .scene__veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    background-color: var(--cu-monte-950);
    opacity: 0;
    pointer-events: none;
  }

  .scene__header--cover {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(5rem, 14vh, 8rem) var(--cu-gutter) clamp(6rem, 16vh, 9rem);
  }

  .scene__cover-caption {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 3;
    display: grid;
    gap: var(--cu-space-3xs);
    padding: var(--cu-space-md) var(--cu-gutter) 4.75rem;
    color: var(--cu-hueso);
  }

  .scene__cover-text {
    max-width: var(--cu-measure);
    font-size: var(--cu-step--1);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .scene__cover-caption :global(.credit),
  .scene__cover-caption :global(.credit__author),
  .scene__cover-caption :global(.credit__license),
  .scene__cover-caption :global(.credit__link) {
    color: var(--cu-bruma-200);
  }

  /* Scroll distance during which the cover is held and nothing else shows. */
  .scene__hold {
    height: 70svh;
    pointer-events: none;
  }

  /* -- The content: a solid field that rises over the held cover ------------ */

  .scene__content {
    position: relative;
    z-index: 1;
    padding-block: var(--cu-chapter-gap);
    /* A flat tone field, one step from the page. */
    background-color: var(--cu-scene-monte);
  }

  .scene--cafe .scene__content {
    background-color: var(--cu-scene-cafe);
  }

  .scene--bruma .scene__content {
    background-color: var(--cu-scene-bruma);
  }

  /* The edge that rises over the photograph gets a soft shadow so it reads as
     a sheet passing over the image, not a seam. */
  .scene--cover .scene__content {
    box-shadow: 0 -3rem 5rem -1.5rem rgba(6, 13, 8, 0.6);
  }

  /* After the story the field follows a photograph, so it needs no curtain
     shadow of its own. */
  .scene--story .scene__content {
    box-shadow: none;
  }

  .scene__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cu-space-xl);
    /* Above the chapter's drawn layer. The plate grows behind the words and
       never crosses the measure. */
    position: relative;
    z-index: 1;
  }

  .scene__body {
    display: grid;
    gap: var(--cu-space-xl);
    min-width: 0;
    width: 100%;
    max-width: 56rem;
    margin-inline: auto;
  }

  .scene__statement {
    width: 100%;
    max-width: 56rem;
    margin-inline: auto;
  }

  /* -- Header --------------------------------------------------------------- */

  .scene__number {
    margin-bottom: var(--cu-space-2xs);
    font-family: var(--cu-font-display);
    font-size: var(--cu-step-1);
    font-style: italic;
    color: var(--cu-accent-soft);
  }

  .scene__title {
    max-width: 16ch;
    font-size: clamp(3rem, 11vw, 9rem);
    line-height: 0.92;
    letter-spacing: var(--cu-tracking-display);
    color: var(--cu-hueso);
    text-wrap: balance;
  }

  .scene__subtitle {
    margin-top: var(--cu-space-xs);
    font-size: var(--cu-step-0);
    font-style: italic;
    color: var(--cu-accent-soft);
  }

  .scene__lede {
    margin-top: var(--cu-space-sm);
    max-width: var(--cu-measure);
    font-size: var(--cu-step-1);
    line-height: var(--cu-leading-quote);
    color: var(--cu-hueso-soft);
  }

  /* No photograph yet: a typographic full screen holds the same rhythm. */
  .scene__header--opener {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 88svh;
    margin-top: calc(var(--cu-chapter-gap) * -0.4);
    padding-bottom: var(--cu-space-xl);
  }

  /* -- The chapter's cita --------------------------------------------------
     One quotation, on its own, at the largest size that is still a sentence
     and not a headline: 36px on a desktop, 24px on a phone. */

  .scene__statement {
    display: grid;
    gap: var(--cu-space-xs);
    margin-block: 0;
  }

  .scene__statement-quote {
    margin: 0;
  }

  .scene__statement-text {
    max-width: 44rem;
    font-family: var(--cu-font-display);
    font-size: 1.5rem; /* 24px — the ceiling on a phone */
    font-style: italic;
    font-variation-settings: 'opsz' 40, 'SOFT' 60, 'WONK' 1, 'wght' 400;
    line-height: 1.32;
    letter-spacing: var(--cu-tracking-display);
    text-wrap: pretty;
    color: var(--cu-hueso);
  }

  @media (min-width: 48rem) {
    .scene__statement-text {
      font-size: 2.25rem; /* 36px — the ceiling on a desktop */
    }
  }

  .scene__statement-caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    max-width: 44rem;
    font-size: var(--cu-step--1);
    color: var(--cu-bruma-300);
  }

  /* -- Narration and evidence ---------------------------------------------- */

  .scene__narration {
    display: grid;
    gap: var(--cu-space-lg);
    min-width: 0;
  }

  .scene__evidence {
    min-width: 0;
  }

  /* -- Aside: tall photographs beside the narration ------------------------- */

  .scene__aside {
    display: grid;
    gap: var(--cu-space-md);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    align-items: start;
    width: 100%;
    max-width: 56rem;
    margin-inline: auto;
  }

  .scene__aside-figure {
    display: grid;
    gap: var(--cu-space-2xs);
    margin: 0;
    min-width: 0;
  }

  .scene__aside-image {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .scene__aside-caption {
    display: grid;
    gap: var(--cu-space-3xs);
    font-size: var(--cu-step--1);
    line-height: 1.5;
    color: var(--cu-text-muted);
  }

  /* -- Pending stub --------------------------------------------------------- */

  .scene__pending {
    max-width: var(--cu-measure);
    padding: clamp(1.25rem, 3vw, 1.9rem);
    background-color: color-mix(in srgb, var(--cu-monte-800) 74%, var(--cu-bg));
    border-left: 3px solid var(--cu-accent);
  }

  .scene__pending-note {
    font-size: var(--cu-step-0);
    line-height: 1.7;
    color: var(--cu-text-muted);
  }

  @media (max-width: 47.99rem) {
    .scene__hold {
      height: 45svh;
    }
  }

  /* Reduced motion: no held frame, no curtain. A full-screen photograph, then
     the text, then the next photograph: complete, plain, still. */
  @media (prefers-reduced-motion: reduce) {
    .scene__cover {
      position: relative;
    }

    .scene__hold {
      display: none;
    }

    .scene--cover .scene__content {
      box-shadow: none;
    }
  }
</style>
