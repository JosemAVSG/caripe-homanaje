---
import { Image } from 'astro:assets';
import type { Chapter, ChapterLayout } from '../content/types';
import Beat from './Beat.astro';
import ChapterGallery from './ChapterGallery.astro';
import ChapterTimeline from './ChapterTimeline.astro';
import CoffeeBranches from './CoffeeBranches.astro';
import EvidencePlates from './EvidencePlates.astro';
import FormingText from './FormingText.astro';
import LexiconPlate from './LexiconPlate.astro';
import PhotoSlot from './PhotoSlot.astro';
import PhotoCreditLine from './PhotoCreditLine.astro';
import SourceNote from './SourceNote.astro';
import { getPhoto } from '../content/photos';
import { site } from '../content/site';
import { reservedPhotos } from '../content/layout';

/**
 * One chapter, staged as a scene.
 *
 * The engine is three parts inside one tall container:
 *   scene__header — the chapter title and its opening line, always in flow;
 *   scene__stage  — the photograph that holds the screen (sticky on desktop,
 *                   a full-bleed band on a phone), with the fog canvas over it;
 *   scene__body   — the narration, evidence, gallery and sources, scrolling
 *                   beside the stage.
 *
 * Scroll progress through the scene is published as the CSS custom property
 * `--p` (0 → 1) by `src/scripts/motion.ts`. With no JavaScript, `--p` stays at
 * its declared 1, so every beat is legible at rest; nothing here depends on
 * script to be readable.
 *
 * DOM order is header → stage → body, so on a phone the title comes first and
 * the photograph follows it full-bleed; on desktop CSS grid moves the stage to
 * its own column and holds it there with `position: sticky`.
 */
interface Props {
  chapter: Chapter;
}

const { chapter } = Astro.props;
const {
  slug,
  title,
  kicker,
  lede,
  tone = 'monte',
  layout: chapterLayout,
  decor,
  beats,
  statement,
  lexicon,
  timeline,
  plates,
  gallery,
  photo,
  sources,
  pending,
  pendingNote,
} = chapter;

/**
 * The composition. `stage` is the original geometry and the default, so a
 * chapter that names no layout is unchanged; `band`, `mist` and `fork` are
 * three other geometries, selected below by class and grid.
 */
const layout: ChapterLayout = chapterLayout ?? 'stage';
const isStage = layout === 'stage';

const titleId = `${slug}-title`;
const hasBeats = beats.length > 0;
const hasStatement = Boolean(statement);
const hasTimeline = Boolean(timeline && timeline.length > 0);
const hasPlates = Boolean(plates && plates.length > 0);

// The hero and the full-bleed band take one photograph each; those never appear
// again here, so no picture is shown twice on the page.
const reserved = new Set(reservedPhotos);
const allImages = (gallery?.images ?? []).filter((image) => !reserved.has(image.photo));

// The stage carries one large photograph per chapter: the first remaining
// `feature` image, or the first image left. It then leaves the grid.
const stageImage = allImages.find((image) => image.layout === 'feature') ?? allImages[0] ?? null;
const restImages = stageImage ? allImages.filter((image) => image !== stageImage) : allImages;
const hasGallery = restImages.length > 0;
const stagePhoto = stageImage ? getPhoto(stageImage.photo) : null;

// Fog density is a design decision about this chapter's weather, not a claim
// about Caripe: the cave chapter is nearly fogless, the mountain chapters are
// the foggiest. Kept out of the content model on purpose.
const FOG: Record<string, 'none' | 'light' | 'dense'> = {
  'chapter-1-1799': 'none',
  'chapter-2-cafe': 'dense',
  'chapter-3-neblina': 'dense',
  'chapter-4-partir': 'light',
};
const fog = FOG[slug] ?? 'light';
---

<section
  class:list={['scene', `scene--${tone}`, pending && 'scene--pending', !isStage && `scene--layout-${layout}`]}
  {...(!isStage ? { 'data-layout': layout } : {})}
  id={slug}
  data-scene
  data-chapter={slug}
  data-time={title}
  style="--p:1"
  aria-labelledby={titleId}
>
  {decor === 'coffee-branches' ? <CoffeeBranches /> : null}

  <div class="scene__inner u-container">
    {
      /*
        The fog composition lets the words condense first: the chapter's cita
        opens the section, full width and alone, before the header. It is the
        same gesture as the hero. In every other layout the cita stays with the
        narration, inside the body.
      */
      layout === 'mist' && statement ? (
        <figure class="scene__statement">
          <blockquote class="scene__statement-quote">
            <FormingText
              as="p"
              class="scene__statement-text"
              text={statement.text}
              start={0.06}
              spread={0.68}
              dur={0.28}
            />
          </blockquote>
          {statement.attribution || statement.placeholder ? (
            <figcaption class="scene__statement-caption">
              {statement.attribution ? <span>{statement.attribution}</span> : null}
              {statement.placeholder ? <span>voz preliminar</span> : null}
            </figcaption>
          ) : null}
        </figure>
      ) : null
    }

    <header class="scene__header" data-reveal-group>
      <h2 class="scene__title" id={titleId} data-reveal>{title}</h2>
      {kicker ? <p class="scene__subtitle" data-reveal>{kicker}</p> : null}
      {lede ? <p class="scene__lede" data-reveal>{lede}</p> : null}
    </header>

    {
      stagePhoto && stageImage ? (
        <figure class="scene__stage" data-stage>
          <div class="scene__stage-frame">
            <Image
              class="scene__stage-image"
              src={stagePhoto.src}
              alt={stageImage.alt}
              widths={[640, 960, 1400]}
              sizes="(min-width: 64rem) 44vw, 100vw"
              format="webp"
              quality={74}
              loading="lazy"
              decoding="async"
            />
            <div class="u-scrim u-scrim--deep" aria-hidden="true" />
            <canvas class="scene__fog" data-fog={fog} aria-hidden="true" />
            <figcaption class="scene__stage-caption">
              <span class="scene__stage-text">{stageImage.caption}</span>
              <PhotoCreditLine credit={stagePhoto.credit} />
            </figcaption>
          </div>
        </figure>
      ) : null
    }

    <div class="scene__body" data-reveal-group>
      {
        layout !== 'mist' && statement ? (
          <figure class="scene__statement">
            <blockquote class="scene__statement-quote">
              <FormingText
                as="p"
                class="scene__statement-text"
                text={statement.text}
                start={0.06}
                spread={0.68}
                dur={0.28}
              />
            </blockquote>
            {statement.attribution || statement.placeholder ? (
              <figcaption class="scene__statement-caption">
                {statement.attribution ? <span>{statement.attribution}</span> : null}
                {statement.placeholder ? <span>voz preliminar</span> : null}
              </figcaption>
            ) : null}
          </figure>
        ) : null
      }

      {hasPlates ? <EvidencePlates plates={plates!} /> : null}

      {
        pending ? (
          <div class="scene__pending" data-reveal>
            <p class="scene__pending-note">{pendingNote}</p>
          </div>
        ) : null
      }

      {
        hasBeats ? (
          <div class="scene__narration">
            {beats.map((beat) => (
              <Beat beat={beat} />
            ))}
          </div>
        ) : null
      }

      {
        lexicon ? (
          <aside class="scene__evidence" aria-label="Evidencia del capítulo">
            <LexiconPlate entry={lexicon} />
          </aside>
        ) : null
      }

      {
        hasGallery ? (
          <ChapterGallery gallery={{ label: gallery!.label, images: restImages }} />
        ) : null
      }

      {isStage && hasTimeline ? <ChapterTimeline milestones={timeline!} /> : null}

      {photo ? <PhotoSlot slot={photo} /> : null}

      <SourceNote sources={sources} note={site.sourceFootnote} />
    </div>

    {/* In the composed layouts the chronology is not one more block inside the
        body: it is a seam that crosses the section on its own. `band` places it
        above the narration, `fork` between the two halves; see the CSS. */}
    {
      !isStage && hasTimeline ? (
        <div class="scene__seam">
          <ChapterTimeline milestones={timeline!} />
        </div>
      ) : null
    }
  </div>
</section>

<style>
  .scene {
    position: relative;
    padding-block: var(--cu-chapter-gap);
    scroll-margin-top: 2rem;
    /* A flat tone field, one step from the page: no screen of the page is
       ever bare ground. */
    background-color: var(--cu-scene-monte);
  }

  /* A chapter can sit at a different temperature from the mountain. The field
     changes as a flat colour; nothing fades into anything. */
  .scene--cafe {
    background-color: var(--cu-scene-cafe);
  }

  .scene--bruma {
    background-color: var(--cu-scene-bruma);
  }

  .scene__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cu-space-lg);
    /* Above the chapter's drawn layer. The plate grows behind the words and
       never crosses the measure. */
    position: relative;
    z-index: 1;
  }

  .scene__header,
  .scene__body {
    min-width: 0;
  }

  .scene__body {
    display: grid;
    gap: var(--cu-space-xl);
  }

  /* -- Header ------------------------------------------------------------- */

  .scene__title {
    font-size: var(--cu-step-5);
    line-height: 0.96;
    letter-spacing: var(--cu-tracking-display);
    color: var(--cu-hueso);
  }

  .scene__subtitle {
    margin-top: var(--cu-space-2xs);
    font-size: var(--cu-step--1);
    font-style: italic;
    color: var(--cu-accent-soft);
  }

  .scene__lede {
    margin-top: var(--cu-space-sm);
    max-width: var(--cu-measure);
    font-size: var(--cu-step-1);
    line-height: var(--cu-leading-quote);
    color: var(--cu-hueso-soft);
  }

  /* -- The chapter's cita --------------------------------------------------
     One quotation, on its own, at the largest size that is still a sentence
     and not a headline: 36px on a desktop, 24px on a phone. Nothing overlaps
     it, and it carries no gradient and no lift. The size and the measure do
     the work. */

  .scene__statement {
    display: grid;
    gap: var(--cu-space-xs);
    margin: 0;
  }

  .scene__statement-quote {
    margin: 0;
  }

  .scene__statement-text {
    max-width: 44rem;
    font-family: var(--cu-font-display);
    font-size: 1.5rem; /* 24px — the ceiling on a phone */
    font-style: italic;
    font-variation-settings: 'opsz' 40, 'SOFT' 60, 'WONK' 1, 'wght' 400;
    line-height: 1.32;
    letter-spacing: var(--cu-tracking-display);
    text-wrap: pretty;
    color: var(--cu-hueso);
  }

  @media (min-width: 48rem) {
    .scene__statement-text {
      font-size: 2.25rem; /* 36px — the ceiling on a desktop */
    }
  }

  /* The one line that says who is speaking, and whether it is yet a record.
     Sentence case: this is a credit, not a label. */
  .scene__statement-caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    max-width: 44rem;
    font-size: var(--cu-step--1);
    color: var(--cu-bruma-300);
  }

  /* -- Stage: the photograph that holds the screen ------------------------ */

  .scene__stage {
    margin: 0;
    /* Full-bleed on a phone: the photograph runs to both edges. */
    margin-inline: calc(var(--cu-gutter) * -1);
  }

  .scene__stage-frame {
    position: relative;
    overflow: clip;
    height: 72svh;
    background-color: var(--cu-monte-900);
  }

  .scene__stage-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The fog canvas paints over the photograph and under the caption. */
  .scene__fog {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .scene__stage-frame :global(.u-scrim) {
    z-index: 1;
  }

  .scene__stage-caption {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 3;
    display: grid;
    gap: var(--cu-space-3xs);
    padding: var(--cu-space-md) var(--cu-gutter) var(--cu-space-sm);
    color: var(--cu-hueso);
  }

  .scene__stage-text {
    max-width: var(--cu-measure);
    font-size: var(--cu-step--1);
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* The credit sits over a photograph; lift it off the faint ink used on the
     page ground. */
  .scene__stage-caption :global(.credit),
  .scene__stage-caption :global(.credit__author),
  .scene__stage-caption :global(.credit__license),
  .scene__stage-caption :global(.credit__link) {
    color: var(--cu-bruma-200);
  }

  /* -- Narration and evidence --------------------------------------------- */

  .scene__narration {
    display: grid;
    gap: var(--cu-space-lg);
    min-width: 0;
  }

  .scene__evidence {
    min-width: 0;
  }

  /* -- Pending stub ------------------------------------------------------- */

  .scene__pending {
    max-width: var(--cu-measure);
    padding: clamp(1.25rem, 3vw, 1.9rem);
    background-color: color-mix(in srgb, var(--cu-monte-800) 74%, var(--cu-bg));
    border-left: 3px solid var(--cu-accent);
  }

  .scene__pending-note {
    font-size: var(--cu-step-0);
    line-height: 1.7;
    color: var(--cu-text-muted);
  }

  /* -- Wide layout: stage left, held; flow right, scrolling --------------- */

  @media (min-width: 64rem) {
    .scene__inner {
      grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
      column-gap: var(--cu-space-xl);
      align-items: start;
    }

    .scene__header {
      grid-column: 2;
      grid-row: 1;
    }

    .scene__body {
      grid-column: 2;
      grid-row: 2;
    }

    /* The signature move: the photograph is pinned in place while the text
       column scrolls past it. Pure CSS, no script required to hold it. */
    .scene__stage {
      grid-column: 1;
      grid-row: 1 / span 2;
      position: sticky;
      top: var(--cu-stage-top);
      align-self: start;
      height: 100svh;
      margin-inline: 0;
    }

    .scene__stage-frame {
      height: 100%;
    }
  }

  /* Reduced motion: no held frame, no scripted beats. Everything is a plain,
     complete document. */
  @media (prefers-reduced-motion: reduce) {
    .scene__stage {
      position: relative;
      top: auto;
      height: auto;
    }

    .scene__stage-frame {
      height: 72svh;
    }
  }

  /* =======================================================================
     Composed layouts.
     `stage` (above) is the original geometry and the default. Each of the
     three below is a different geometry - a different grid, a different place
     for the photograph, a different block leading the section - not a
     reordering of the same blocks.
     ===================================================================== */

  /* -- The seam: a chronology that crosses the section on its own ---------- */

  .scene__seam {
    min-width: 0;
  }

  /* -- band: the photograph runs as a wide horizontal strip; the chronology
        crosses the section; the narration sits in a narrow measure below it.
        The idea: the coffee is a calendar, a line in time. ----------------- */

  .scene--layout-band .scene__stage {
    position: relative;
    height: clamp(15rem, 40svh, 23rem);
  }

  .scene--layout-band .scene__stage-frame {
    height: 100%;
  }

  /* The narration drops to a narrow column, so the eye reads the wide band
     above it and the line across as one horizontal gesture. */
  .scene--layout-band .scene__narration,
  .scene--layout-band .scene__pending {
    max-width: var(--cu-measure-narrow);
  }

  /* The chronology crosses the whole section, edges to edge. */
  .scene--layout-band .scene__seam {
    margin-inline: calc(var(--cu-gutter) * -1);
  }

  /* -- mist: the statement opens the section over the fog, before the
        heading, and the photographs enter afterwards in a strip. The words
        condense out of the weather, the same gesture the hero uses. ------- */

  .scene--layout-mist .scene__stage {
    position: relative;
    height: clamp(17rem, 48svh, 26rem);
  }

  .scene--layout-mist .scene__stage-frame {
    height: 100%;
  }

  /* -- fork: two halves that face each other, with the chronology as the
        seam between them. Staying or leaving has two sides. ---------------- */

  .scene--layout-fork .scene__stage {
    position: relative;
    /* Each half reads as a panel, so the photograph is held inside the
       measure instead of running to both edges. */
    margin-inline: 0;
    height: clamp(20rem, 56svh, 32rem);
  }

  .scene--layout-fork .scene__stage-frame {
    height: 100%;
  }

  /* -- Wide: the composed grids ------------------------------------------- */

  @media (min-width: 64rem) {
    /* band: one full-width run; the band, the chronology seam, then the
       narration in a narrow measure below it. */
    .scene--layout-band .scene__inner {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--cu-space-lg);
    }

    .scene--layout-band .scene__header {
      grid-column: 1;
      grid-row: 1;
    }

    .scene--layout-band .scene__stage {
      grid-column: 1;
      grid-row: 2;
      position: relative;
      height: clamp(20rem, 52svh, 38rem);
      margin-inline: calc(var(--cu-gutter) * -1);
    }

    .scene--layout-band .scene__seam {
      grid-column: 1;
      grid-row: 3;
    }

    .scene--layout-band .scene__body {
      grid-column: 1;
      grid-row: 4;
    }

    /* mist: content hangs off-centre in the wide column; the right column is
       a deliberate void where the fog sits. The statement spans the lot. */
    .scene--layout-mist .scene__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.28fr);
      column-gap: var(--cu-space-2xl);
      align-items: start;
    }

    /* The block below returns the section to one stack, so the base rows
       (`stage` pins itself across rows 1-2) must not leak in: every child
       takes its own row in DOM order — statement, title, strip, narration —
       and nothing is laid over anything. */
    .scene--layout-mist .scene__statement,
    .scene--layout-mist .scene__stage,
    .scene--layout-mist .scene__seam {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .scene--layout-mist .scene__header,
    .scene--layout-mist .scene__body {
      grid-column: 1;
      grid-row: auto;
    }

    .scene--layout-mist .scene__stage {
      position: static;
      grid-row: auto;
      height: clamp(18rem, 46svh, 32rem);
      margin-inline: calc(var(--cu-gutter) * -1);
    }

    /* fork: two equal halves that face each other, the seam crossing below
       them, the rest of the chapter running full width underneath. */
    .scene--layout-fork .scene__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--cu-space-2xl);
      row-gap: var(--cu-space-xl);
      align-items: center;
    }

    .scene--layout-fork .scene__header {
      grid-column: 1;
      grid-row: 1;
    }

    .scene--layout-fork .scene__stage {
      grid-column: 2;
      grid-row: 1;
      position: relative;
      margin-inline: 0;
      height: clamp(24rem, 62svh, 44rem);
    }

    .scene--layout-fork .scene__seam {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .scene--layout-fork .scene__body {
      grid-column: 1 / -1;
      grid-row: 3;
    }
  }
</style>
