---
import type { PhotoSlot as PhotoSlotData } from '../content/types';

/**
 * A reserved frame for photography that does not exist yet.
 *
 * The brief forbids placeholder imagery, so this is an honest, designed empty
 * frame: a flat tone panel, a small aperture mark, and the caption the eventual
 * photograph will carry. When real images arrive, replace the frame with an
 * `<img>`; the caption markup already fits a `<figure>`. No dashed edge, no
 * gradient, no uppercase label.
 */
interface Props {
  slot: PhotoSlotData;
}

const { slot } = Astro.props;
---

<figure class="photo" data-photo-slot data-reveal>
  <div class="photo__frame" aria-hidden="true">
    <svg class="photo__mark" viewBox="0 0 48 48" focusable="false">
      <circle cx="24" cy="24" r="15" fill="none" stroke="currentColor" stroke-width="1.1" />
      <path d="M6.5 24h9l4.5-8 5 16 4-8h12.5" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round" />
    </svg>
    <span class="photo__label">Espacio reservado</span>
  </div>

  <figcaption class="photo__caption">
    <span class="photo__text">{slot.caption}</span>
    {slot.credit ? <span class="photo__credit">{slot.credit}</span> : null}
  </figcaption>
</figure>

<style>
  .photo {
    margin: var(--cu-space-xl) 0 0;
  }

  .photo__frame {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--cu-space-xs);
    aspect-ratio: 3 / 2;
    background-color: color-mix(in srgb, var(--cu-monte-800) 62%, var(--cu-bg));
    color: color-mix(in srgb, var(--cu-bruma-300) 60%, transparent);
  }

  .photo__mark {
    width: 3rem;
    height: 3rem;
  }

  .photo__label {
    font-size: var(--cu-step--2);
  }

  .photo__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5em var(--cu-space-xs);
    margin-top: var(--cu-space-xs);
    max-width: var(--cu-measure);
    font-size: var(--cu-step--1);
    line-height: 1.6;
    color: var(--cu-text-muted);
  }

  .photo__credit {
    font-size: var(--cu-step--2);
    color: var(--cu-text-faint);
  }
</style>
