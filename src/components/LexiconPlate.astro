---
import type { LexiconEntry } from '../content/types';

/**
 * A term the documentary stops at. Used for the scientific name that ties the
 * town to the bird — the factual spine of chapter 01.
 *
 * There is no label above the term: a small caption sitting over a heading is
 * exactly the eyebrow the house style bans. The term, its gloss and its note
 * carry the meaning on their own, and the panel is a flat cafe surface — no
 * gradient, no border.
 */
interface Props {
  entry: LexiconEntry;
}

const { entry } = Astro.props;
---

<aside class="lexicon" data-lexicon data-reveal>
  <p class="lexicon__term">
    <span lang={entry.lang ?? 'la'}>{entry.term}</span>
  </p>

  <p class="lexicon__gloss">{entry.gloss}</p>

  {entry.note ? <p class="lexicon__note">{entry.note}</p> : null}
</aside>

<style>
  .lexicon {
    padding: clamp(1.25rem, 3vw, 1.9rem);
    background-color: color-mix(in srgb, var(--cu-cafe-900) 84%, transparent);
  }

  .lexicon__term {
    font-family: var(--cu-font-display);
    font-size: var(--cu-step-2);
    font-style: italic;
    font-variation-settings: 'opsz' 40, 'SOFT' 40, 'WONK' 1;
    line-height: 1.15;
    color: var(--cu-hueso);
  }

  .lexicon__gloss {
    margin-top: var(--cu-space-3xs);
    font-size: var(--cu-step-1);
    font-style: italic;
    color: var(--cu-accent-soft);
  }

  .lexicon__note {
    margin-top: var(--cu-space-sm);
    max-width: var(--cu-measure);
    font-size: var(--cu-step--1);
    line-height: 1.65;
    color: var(--cu-text-muted);
  }
</style>
