---
import engraving from '../assets/fotos/Figura-9-El-guacharo-o-pajaro-del-aceite-Steatornis-caripensis-Altringham-1996-removebg-preview.png';

/**
 * Guacharo — an oilbird perched on a branch, drawn from Altringham's 1996
 * engraving (black ink turned bone-white, mirrored to face the title).
 *
 * The branch is the same white, fill-less line as the rest of the page's
 * drawings. Decorative by construction: `aria-hidden`, no text, and it only
 * appears where there is empty room beside the title. It fades in after the
 * intro; with no motion it is simply there.
 */
---

<div class="guacharo" aria-hidden="true">
  <svg viewBox="0 0 420 300" focusable="false">
    <!-- The branch, with two leaves. -->
    <path d="M10 240 C120 230 230 218 410 196"></path>
    <path d="M10 254 C130 246 240 234 410 214"></path>
    <path d="M70 236 C60 214 48 206 30 204 C36 220 50 232 70 238Z"></path>
    <path d="M120 232 C116 208 126 192 144 184 C150 202 142 222 124 232Z"></path>

    <!-- Perched: Altringham's 1996 engraving, mirrored to face the title. -->
    <g class="guacharo__perched">
      <image
        class="engraving"
        href={engraving.src}
        x="132"
        y="56"
        width="236"
        height="258"
        preserveAspectRatio="xMidYMid meet"></image>
    </g>
  </svg>
</div>

<style>
  .guacharo {
    display: none;
    pointer-events: none;
  }

  /* There is only room beside the title on a wide screen. */
  @media (min-width: 60rem) {
    .guacharo {
      display: block;
      position: absolute;
      top: clamp(3rem, 2rem + 5vw, 8rem);
      right: var(--cu-gutter);
      width: min(34rem, 38vw);
    }
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    fill: none;
    stroke: var(--cu-hueso);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Black ink on transparent, turned into bone-white ink; mirrored and tilted
     so the bird faces the title and sits along the branch. */
  .engraving {
    filter: invert(1) brightness(0.96) sepia(0.12);
    transform-box: fill-box;
    transform-origin: 50% 50%;
    transform: scaleX(-1) rotate(24deg);
  }

  /* -- Motion: the bird fades in on its branch. ------------------------- */

  .guacharo__perched {
    animation: cu-guacharo-appear 1.6s var(--cu-ease) 1.6s both;
  }

  @keyframes cu-guacharo-appear {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .guacharo__perched {
      animation: none;
    }
  }
</style>
