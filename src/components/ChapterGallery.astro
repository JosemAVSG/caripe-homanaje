---
import type { ChapterGallery } from '../content/types';
import { getPhoto } from '../content/photos';
import FullBleedImage from './FullBleedImage.astro';
import PhotoCreditLine from './PhotoCreditLine.astro';

/**
 * A chapter's photographic documentation, as one pinned full-screen scene.
 *
 * With motion on, the reel is a tall section holding a single sticky stage; the
 * photographs are stacked inside it and `motion.ts` plays them as a slow,
 * scroll-scrubbed sequence: each one dissolves into view, holds still while its
 * caption fades in and is read, the caption leaves, and only then does the next
 * photograph begin to dissolve. Nothing cuts and nothing flashes.
 *
 * With reduced motion, or without script, the panels are simply a run of
 * full-screen photographs, one after another.
 *
 * Caption and attribution stay inside the `<figcaption>`, as the licences
 * require. Each panel is a real `<figure>` with the honest alt text.
 */
interface Props {
  gallery: ChapterGallery;
}

const { gallery } = Astro.props;
const panels = gallery.images.map((image) => ({ image, photo: getPhoto(image.photo) }));
const total = panels.length;
---

<section class="reel" style={`--n:${total}`} aria-label={gallery.label ?? 'Fotografías del capítulo'} data-reel>
  <div class="reel__stage" data-reel-stage>
  {
    panels.map(({ image, photo }, index) => (
      <figure class="reel__panel" data-reel-panel>
        <FullBleedImage src={photo.src} alt={image.alt} />
        <div class="u-scrim u-scrim--deep" aria-hidden="true" />
        <figcaption class="reel__caption">
          {gallery.label ? (
            <span class="reel__count">
              {gallery.label} · {String(index + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}
            </span>
          ) : null}
          <span class="reel__text">{image.caption}</span>
          <PhotoCreditLine credit={photo.credit} />
        </figcaption>
      </figure>
    ))
  }
  </div>
</section>

<style>
  .reel {
    position: relative;
    z-index: 1;
    background-color: var(--cu-monte-950);
  }

  .reel__panel {
    position: relative;
    margin: 0;
    height: 100svh;
    overflow: hidden;
    background-color: var(--cu-monte-900);
  }

  /* Pinned mode, switched on by motion.ts: one sticky screen, N slots of
     scroll, every photograph stacked in it. */
  .reel:global(.is-pinned) {
    height: calc(var(--n) * var(--cu-reel-slot, 240svh));
  }

  .reel:global(.is-pinned) .reel__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  .reel:global(.is-pinned) .reel__panel {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  .reel__caption {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 3;
    display: grid;
    gap: var(--cu-space-3xs);
    padding: var(--cu-space-md) var(--cu-gutter) 4.75rem;
    color: var(--cu-hueso);
  }

  .reel__count {
    font-size: var(--cu-step--2);
    letter-spacing: 0.04em;
    color: var(--cu-accent-soft);
  }

  .reel__text {
    max-width: 42rem;
    font-family: var(--cu-font-display);
    font-size: var(--cu-step-1);
    font-weight: 350;
    line-height: 1.35;
    text-wrap: pretty;
    color: var(--cu-hueso);
  }

  .reel__caption :global(.credit),
  .reel__caption :global(.credit__author),
  .reel__caption :global(.credit__license),
  .reel__caption :global(.credit__link) {
    color: var(--cu-bruma-200);
  }

  @media (max-width: 47.99rem) {
    .reel {
      --cu-reel-slot: 200svh;
    }
  }
</style>
