---
import PhotoCreditLine from './PhotoCreditLine.astro';
import { site } from '../content/site';
import { photoCredits } from '../content/photos';
import { collageMaps, collagePhotographs } from '../content/collage';

const { colophon } = site;
const year = new Date().getFullYear();

/** The file name is provenance, not a title: show it without its extension. */
const display = (credit: { title: string }) => credit.title.replace(/\.[a-z0-9]+$/i, '');

/** The archive, plus the one photograph that opens the site in the hero. */
const works = [...photoCredits, ...collagePhotographs].map((credit) => ({
  ...credit,
  displayTitle: display(credit),
}));

/** The historical cartography of the hero collage, credited separately. */
const maps = collageMaps.map((credit) => ({
  ...credit,
  displayTitle: display(credit),
}));
---

<footer class="colophon" id="colophon" aria-labelledby="colophon-title">
  <div class="colophon__inner u-container">
    <h2 class="colophon__thanks" id="colophon-title" data-reveal>{colophon.thanks}</h2>

    <p class="colophon__intro" data-reveal>{colophon.intro}</p>

    <div class="colophon__notes">
      {
        colophon.paragraphs.map((paragraph) => (
          <p class="colophon__note" data-reveal>
            {paragraph}
          </p>
        ))
      }
    </div>

    <section class="credits" aria-labelledby="credits-title" data-reveal>
      <h3 class="credits__title" id="credits-title">{colophon.creditsTitle}</h3>

      <p class="credits__intro">{colophon.creditsIntro}</p>

      <ul class="credits__list">
        {
          works.map((work) => (
            <li class="credits__item">
              <span class="credits__work">{work.displayTitle}</span>
              <PhotoCreditLine credit={work} />
            </li>
          ))
        }
      </ul>

      <p class="credits__changes">{colophon.creditsChanges}</p>
    </section>

    <section class="credits credits--maps" aria-labelledby="credits-maps-title" data-reveal>
      <h3 class="credits__title" id="credits-maps-title">{colophon.mapsTitle}</h3>

      <p class="credits__intro">{colophon.mapsIntro}</p>

      <ul class="credits__list">
        {
          maps.map((map) => (
            <li class="credits__item">
              <span class="credits__work">{map.displayTitle}</span>
              <PhotoCreditLine credit={map} />
            </li>
          ))
        }
      </ul>
    </section>

    <p class="colophon__year" data-reveal>
      <span aria-hidden="true">{year}</span>
      <span class="u-visually-hidden">Sitio publicado en {year}.</span>
    </p>
  </div>
</footer>

<style>
  .colophon {
    padding-block: var(--cu-space-3xl) var(--cu-space-2xl);
    /* A lifted tone, one step from the page: the closing field is warmer than
       the mountain but still flat. No gradient, no rule. */
    background-color: var(--cu-scene-close);
  }

  .colophon__thanks {
    max-width: 34rem;
    font-family: var(--cu-font-display);
    font-size: var(--cu-step-4);
    font-weight: 400;
    font-style: italic;
    font-variation-settings: 'opsz' 144, 'SOFT' 60, 'WONK' 1;
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--cu-hueso);
  }

  .colophon__intro {
    margin-top: var(--cu-space-sm);
    max-width: var(--cu-measure);
    font-size: var(--cu-step-1);
    line-height: 1.6;
    color: var(--cu-hueso-soft);
  }

  .colophon__notes {
    display: grid;
    gap: var(--cu-space-sm);
    margin-top: var(--cu-space-xl);
    max-width: var(--cu-measure-wide);
  }

  @media (min-width: 48rem) {
    .colophon__notes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--cu-space-md);
    }
  }

  .colophon__note {
    font-size: var(--cu-step--1);
    line-height: 1.75;
    color: var(--cu-text-faint);
  }

  /* -- Image credits ------------------------------------------------------
     A licence obligation and, just as much, a reader's tool: every photograph
     on the page can be traced from here back to its author and its source. */

  .credits {
    margin-top: var(--cu-space-2xl);
    max-width: var(--cu-page-max);
  }

  /* The map block follows the photographic one; keep them a touch closer than
     the gap that separates them from the prose above. */
  .credits--maps {
    margin-top: var(--cu-space-xl);
  }

  .credits__title {
    font-family: var(--cu-font-display);
    font-size: var(--cu-step-2);
    font-weight: 400;
    color: var(--cu-hueso);
  }

  .credits__intro {
    margin-top: var(--cu-space-sm);
    max-width: 46rem;
    font-size: var(--cu-step--1);
    line-height: 1.75;
    color: var(--cu-text-muted);
  }

  .credits__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cu-space-sm) var(--cu-space-md);
    margin-top: var(--cu-space-lg);
  }

  @media (min-width: 48rem) {
    .credits__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .credits__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .credits__item {
    min-width: 0;
  }

  .credits__work {
    display: block;
    margin-bottom: var(--cu-space-3xs);
    font-size: var(--cu-step--1);
    font-style: italic;
    line-height: 1.5;
    color: var(--cu-hueso-soft);
    overflow-wrap: anywhere;
  }

  .credits__changes {
    margin-top: var(--cu-space-lg);
    max-width: 46rem;
    font-size: var(--cu-step--2);
    line-height: 1.75;
    color: var(--cu-text-faint);
  }

  .colophon__year {
    margin-top: var(--cu-space-xl);
    font-size: var(--cu-step--2);
    color: var(--cu-text-faint);
    font-variant-numeric: lining-nums;
  }
</style>
