---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ChapterSection from '../components/ChapterSection.astro';
import PhotoBand from '../components/PhotoBand.astro';
import DocumentaryMode from '../components/DocumentaryMode.astro';
import ProgressRail from '../components/ProgressRail.astro';
import Colophon from '../components/Colophon.astro';
import Familias from '../components/Familias.astro';
import Colegios from '../components/Colegios.astro';
import { chapters } from '../content';
import { site } from '../content/site';

const pageTitle = `${site.title} · ${site.fullTitle} · homenaje documental`;

// The full-bleed band breaks the run of chapters roughly in the middle: after
// the second chapter, before the third.
const bandAfterIndex = Math.floor(chapters.length / 2) - 1;
---

<BaseLayout title={pageTitle} description={site.description}>
  <div class="progress" aria-hidden="true">
    <span class="progress__fill" data-progress-fill></span>
  </div>

  <ProgressRail chapters={chapters} />
  <DocumentaryMode />

  <main id="main">
    <Hero />

    {
      chapters.map((chapter, index) => (
        <Fragment>
          <ChapterSection chapter={chapter} />
          {index === bandAfterIndex ? <PhotoBand /> : null}
        </Fragment>
      ))
    }

    <Familias />
    <Colegios />
  </main>

  <Colophon />
</BaseLayout>
